# Copy to .env and adjust. Restart Expo after changes.
#
# See docs/RAILWAY_ARCHITECTURE.md and docs/RAILWAY_ENV_VARS.md
#
# development + staging → staging Railway backend (safe for QA)
# production            → api.korook.com (live users only)
#
EXPO_PUBLIC_API_ENV=development
#
# Optional override (wins over EXPO_PUBLIC_API_ENV):
# EXPO_PUBLIC_API_BASE_URL=https://community-app-backend-staging.up.railway.app/api
# EXPO_PUBLIC_API_BASE_URL=https://api.korook.com/api
