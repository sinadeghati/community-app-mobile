# Copy to .env and adjust. Restart Expo after changes.
#
# See docs/RAILWAY_ARCHITECTURE.md and docs/RAILWAY_ENV_VARS.md
#
# development + staging → staging Railway backend (safe for QA)
# production            → api.korook.com (live users only)
#
EXPO_PUBLIC_API_ENV=development
#
# Optional override (wins over EXPO_PUBLIC_API_ENV):
# EXPO_PUBLIC_API_BASE_URL=https://community-app-backend-staging.up.railway.app/api
# EXPO_PUBLIC_API_BASE_URL=https://api.korook.com/api
#
# Public OAuth client IDs (not secrets) — staging:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID_STAGING=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID_STAGING=yyyy.apps.googleusercontent.com
# Production placeholders (do not use on staging builds):
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID_PRODUCTION=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID_PRODUCTION=
#
# Required for Android release/staging builds using react-native-maps (EAS secret recommended):
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=your_google_maps_sdk_android_key
